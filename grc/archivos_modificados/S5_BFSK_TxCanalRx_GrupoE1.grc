options:
  parameters:
    author: Grupo E1
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'S5 Telemetria binaria BFSK: Tx CPFSK, canal AWGN y receptor no coherente (filtro de canal, discriminador, integrador, muestreo, slicer y BER).'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: S5_BFSK_TxCanalRx_GrupoE1
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'S5 - Telemetria binaria BFSK: Tx - canal AWGN - Rx'
    window_size: (1500,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_math
  id: import
  parameters:
    imports: import math
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 8
    rotation: 0
    state: enabled
- name: import_firdes
  id: import
  parameters:
    imports: from gnuradio.filter import firdes
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 56
    rotation: 0
    state: enabled
- name: import_window
  id: import
  parameters:
    imports: from gnuradio.fft import window
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 104
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    value: 1e6
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 8
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    value: '100'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 8
    rotation: 0
    state: enabled
- name: symbol_rate
  id: variable
  parameters:
    value: samp_rate/sps
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 8
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    value: symbol_rate
    comment: 'BFSK binaria: Rb = Rs'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 8
    rotation: 0
    state: enabled
- name: h_fsk
  id: variable
  parameters:
    value: 2*fsk_deviation/symbol_rate
    comment: Indice de modulacion
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 620
    - 8
    rotation: 0
    state: enabled
- name: fsk_deviation
  id: variable_qtgui_range
  parameters:
    gui_hint: ''
    label: Desviacion FSK (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '5000'
    step: '1000'
    stop: '100000'
    value: '10000'
    widget: counter_slider
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 740
    - 8
    rotation: 0
    state: enabled
- name: noise_voltage
  id: variable_qtgui_range
  parameters:
    gui_hint: ''
    label: Noise voltage (A=0, B=0.3, C=0.6, D=0.8)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.01'
    stop: '5.0'
    value: '0.6'
    widget: counter_slider
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 940
    - 8
    rotation: 0
    state: enabled
- name: receptor
  id: variable_qtgui_chooser
  parameters:
    gui_hint: ''
    label: Receptor
    type: int
    num_opts: '2'
    option0: '0'
    label0: 'R1: discriminador directo (base)'
    option1: '1'
    label1: 'R2: filtro de canal + discriminador'
    value: '1'
    widget: combo_box
    orient: Qt.QVBoxLayout
    labels: '[]'
    options: '[0, 1, 2]'
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1180
    - 8
    rotation: 0
    state: enabled
- name: lpf_cutoff
  id: variable
  parameters:
    value: 20e3
    comment: = fsk_deviation + symbol_rate (recalcular si cambia el diseno)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 200
    rotation: 0
    state: enabled
- name: lpf_width
  id: variable
  parameters:
    value: 10e3
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 200
    rotation: 0
    state: enabled
- name: lpf_taps
  id: variable
  parameters:
    value: firdes.low_pass(1.0, samp_rate, lpf_cutoff, lpf_width, window.WIN_HAMMING, 6.76)
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 200
    rotation: 0
    state: enabled
- name: lpf_delay
  id: variable
  parameters:
    value: (len(lpf_taps)-1)//2
    comment: Retardo de grupo del filtro de canal (muestras)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 200
    rotation: 0
    state: enabled
- name: skip_muestreo
  id: variable
  parameters:
    value: (lpf_delay + ajuste_muestreo) % sps
    comment: 'Fase de muestreo: ultima muestra de cada ventana'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 840
    - 200
    rotation: 0
    state: enabled
- name: ajuste_muestreo
  id: variable
  parameters:
    value: '0'
    comment: Ajuste fino (muestras), fijarlo en la Prueba A
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1010
    - 200
    rotation: 0
    state: enabled
- name: retardo_bits
  id: variable
  parameters:
    value: (lpf_delay + ajuste_muestreo)//sps
    comment: 'D_b: retardo de la referencia Tx en bits'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1150
    - 200
    rotation: 0
    state: enabled
